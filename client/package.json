@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  --bg: #f5f7fb;
  --panel: #ffffff;
  --primary: #5b4df6;
  --primary-dark: #402ed2;
  --secondary: #edf1ff;
  --text: #18212f;
  --muted: #6f7b8a;
  --border: #e6eaf2;
  --success: #13a86e;
  --shadow: 0 18px 40px rgba(28, 38, 62, 0.08);
}

* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  font-family: 'Inter', sans-serif;
  background: var(--bg);
  color: var(--text);
}

button, input {
  font: inherit;
}

button {
  cursor: pointer;
  border: none;
}

.auth-shell {
  min-height: 100vh;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #eef2ff, #f7f9fc);
  padding: 24px;
}

.auth-card {
  width: min(560px, 100%);
  background: white;
  border-radius: 28px;
  padding: 40px 32px;
  box-shadow: var(--shadow);
}

.auth-card h1 {
  margin: 16px 0 10px;
  font-size: clamp(2rem, 2.3vw, 2.8rem);
  line-height: 1.1;
}

.auth-card p {
  color: var(--muted);
  margin: 0 0 24px;
  line-height: 1.6;
}

.badge {
  display: inline-flex;
  align-items: center;
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(91, 77, 246, 0.1);
  color: var(--primary);
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  font-size: 0.72rem;
}

.form-grid {
  display: grid;
  gap: 14px;
}

.form-grid input {
  width: 100%;
  padding: 14px 16px;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: #fdfdff;
}

.button-row {
  display: flex;
  gap: 12px;
  margin-top: 22px;
}

button.primary, button.secondary, button.nav {
  border-radius: 12px;
  padding: 12px 18px;
  font-weight: 600;
}

button.primary {
  background: var(--primary);
  color: white;
}

button.secondary {
  background: var(--secondary);
  color: var(--text);
}

button.nav {
  background: transparent;
  color: var(--muted);
}

button.nav.active {
  background: var(--secondary);
  color: var(--primary);
}

.app-shell {
  max-width: 1200px;
  margin: 0 auto;
  padding: 28px 20px 60px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-bottom: 28px;
}

.logo {
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--primary);
}

.muted {
  color: var(--muted);
  font-size: 0.9rem;
}

nav {
  display: flex;
  align-items: center;
  gap: 10px;
}

.content {
  display: grid;
  gap: 24px;
}

.hero-card,
.panel,
.stat-card,
.profile-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 24px;
  box-shadow: var(--shadow);
}

.hero-card {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding: 28px;
  align-items: center;
}

.hero-card h2 {
  margin: 14px 0 8px;
  font-size: clamp(2rem, 2vw, 2.8rem);
}

.hero-card p {
  margin: 0;
  color: var(--muted);
  max-width: 640px;
  line-height: 1.6;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.stat-card {
  padding: 20px 22px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.stat-card span {
  text-transform: uppercase;
  letter-spacing: 0.04em;
  font-size: 0.72rem;
  color: var(--muted);
}

.stat-card strong {
  font-size: 2rem;
}

.panel-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.panel {
  padding: 22px;
}

.panel h3 {
  margin-top: 0;
  font-size: 1.2rem;
}

.checklist {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  gap: 12px;
}

.checklist li {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--text);
}

.checklist li::before {
  content: '✓';
  width: 22px;
  height: 22px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: rgba(19, 168, 110, 0.12);
  color: var(--success);
  font-weight: 700;
}

.recommendation-row {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid var(--border);
}

.recommendation-row:last-child {
  border-bottom: none;
}

.recommendation-row small {
  display: block;
  color: var(--muted);
  margin-top: 4px;
}

.card-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 18px;
}

.profile-card {
  padding: 20px;
}

.profile-card.compact {
  min-height: 200px;
}

.profile-header {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: flex-start;
  margin-bottom: 10px;
}

.profile-header h4 {
  margin: 0 0 6px;
  font-size: 1.1rem;
}

.profile-header span {
  color: var(--muted);
  font-size: 0.9rem;
}

.profile-card p {
  color: var(--muted);
  line-height: 1.6;
  margin: 0 0 14px;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 16px;
}

.tags span {
  background: rgba(91, 77, 246, 0.08);
  color: var(--primary);
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 0.8rem;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  color: var(--muted);
  margin-bottom: 18px;
  font-size: 0.85rem;
}

.timeline {
  display: grid;
  gap: 16px;
}

.timeline-item {
  display: flex;
  gap: 16px;
  padding: 14px 0;
  border-bottom: 1px solid var(--border);
}

.timeline-item:last-child {
  border-bottom: none;
}

.timeline-badge {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: var(--primary);
  margin-top: 6px;
}

.timeline-item strong {
  display: block;
  margin-bottom: 4px;
}

.timeline-item p,
.timeline-item small {
  margin: 0;
  color: var(--muted);
}

@media (max-width: 760px) {
  .topbar,
  .hero-card {
    flex-direction: column;
    align-items: flex-start;
  }

  nav {
    flex-wrap: wrap;
  }

  .stats-grid,
  .panel-grid {
    grid-template-columns: 1fr;
  }
}

